      "hydrogen": {
        "id": "gemini-4-hydrogen",
        "nivel": "básico",
        "custo": "baixo",
        "velocidade": "muito rápido",
        "quando": "só perguntas muito básicas (consultas rápidas, formatação)"
      },
      "argon": {
        "id": "gemini-4-argon",
        "nivel": "antigo",
        "custo": "médio",
        "velocidade": "médio",
        "quando": "evitar: geração anterior, substituído pelo neon"
      }
    },
    "modeloPadrao": "neon",
    "_notaModelos": "Confira os ids exatos com /model dentro do agy e ajuste 'id' se precisar."
  },
