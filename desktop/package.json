{
  "name": "ktn-office",
  "productName": "KTN Office",
  "version": "0.3.0",
  "description": "Escritório onde várias IAs (Claude, Gemini/Antigravity, Codex, Copilot e outras) dividem e fazem o trabalho juntas.",
  "author": "KTN Dev",
  "license": "MIT",
  "homepage": "https://github.com/reireymond/KTN-Office",
  "main": "main.js",
  "scripts": {
    "servidor": "npm --prefix ../server run build",
    "start": "npm run servidor && electron .",
    "dist": "npm run servidor && electron-builder",
    "dist:win": "npm run servidor && electron-builder --win",
    "dist:linux": "npm run servidor && electron-builder --linux",
    "dist:mac": "npm run servidor && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "cross-spawn": "^7.0.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.ktn.office",
    "productName": "KTN Office",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "build/*.png",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "app/server/dist"
      },
      {
        "from": "../server/public",
        "to": "app/server/public"
      },
      {
        "from": "../server/package.json",
        "to": "app/server/package.json"
      },
      {
        "from": "../agents",
        "to": "app/agents",
        "filter": [
          "**/*",
          "!clis.custom.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KTN Office",
      "artifactName": "KTN-Office-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "KTN-Office-Portatil-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "KTN-Office-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "KTN-Office-${version}.${ext}"
    }
  }
}
